<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Is the phone on Wi-Fi (adb/LocalAdb: Wireless debugging needs it to start the helper), and the Wi-Fi watch. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Finds Wireless debugging's ports over mDNS (NsdManager) on the phone itself. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Granted by the helper (shell/PhoneSetup), never by Android: lets the app switch Wireless debugging back on to
         restart the helper after a reboot. Undeclared, `pm grant` exits 0 and grants nothing (Pixel, Android 17). -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- PairingService: a short foreground service while it pairs. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Sebastian's wake-word listener: a microphone foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- libadb-android's manifest has no targetSdk, so the merger implies these two; nothing of ours uses storage, and
         Play's Data safety review asks about every declared permission. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        tools:node="remove" />

    <application
        android:name=".CallStreamApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CallStream">

        <!-- singleTask: an agent file opened from WhatsApp lands in the running app (onNewIntent), not a second copy. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Agent files (.callstream). Chat apps and file managers send them as generic or JSON documents, without the
                 name, so the app accepts those types and the helper turns away anything that isn't an agent file. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/json" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/json" />
            </intent-filter>
            <!-- Lead lists (Excel, CSV): "Open with" and Share from WhatsApp or a file manager open the lead preview.
                 The contents decide, not the type: some apps label CSV as Excel. -->
            <intent-filter android:label="Add leads">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                <data android:mimeType="application/vnd.ms-excel" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="text/comma-separated-values" />
                <data android:mimeType="text/tab-separated-values" />
            </intent-filter>
            <intent-filter android:label="Add leads">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                <data android:mimeType="application/vnd.ms-excel" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="text/comma-separated-values" />
                <data android:mimeType="text/tab-separated-values" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".ProbeReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="dev.rawaiz.sebastian.RUN" />
            </intent-filter>
        </receiver>

        <!-- Starts the helper again after a reboot, on its retries, and when Wi-Fi comes up after a start failed for
             want of it. These actions only attempt a helper start, so exposing them is harmless (and lets adb simulate a boot). -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="dev.rawaiz.sebastian.BOOT_RETRY" />
                <action android:name="dev.rawaiz.sebastian.WIFI_UP" />
            </intent-filter>
        </receiver>

        <!-- Every 15 minutes: starts the helper again if it died while the app was closed (HelperRevive). -->
        <service
            android:name=".HelperKeepAlive"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- "Sebastian, cut the call": presses the hang-up button on WhatsApp's call notification. -->
        <service
            android:name=".CallNotificationListener"
            android:exported="true"
            android:label="Sebastian"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- The helper (shell) asks for that hang-up. DUMP: only the shell can send it. -->
        <receiver
            android:name=".HangupReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <!-- The helper (shell) asks who the WhatsApp call is with. DUMP: only the shell can send it. -->
        <receiver
            android:name=".CallInfoReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <service
            android:name=".WakeService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Pairs with Wireless debugging when the code is typed into its notification. -->
        <service
            android:name=".PairingService"
            android:exported="false"
            android:foregroundServiceType="shortService" />

        <!-- Fires WhatsApp's Answer / Hang-up for the helper (am start from the shell user only), then closes. -->
        <activity
            android:name=".WhatsAppCallActivity"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:launchMode="singleInstance"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- No NotificationListenerService: declaring notification access gets the APK blocked by Play Protect's enhanced
             fraud protection on browser installs (0.24.1–0.25.0). The helper reads WhatsApp's call notices itself. -->

        <!-- The shell helper delivers its binder here; call() accepts only the shell/root uid. -->
        <provider
            android:name=".HelperProvider"
            android:authorities="${applicationId}.helper"
            android:exported="true" />

        <!-- Exported lead sheets for the share sheet. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
